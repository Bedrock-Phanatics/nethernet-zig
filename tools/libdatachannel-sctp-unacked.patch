+// The output queue only shrinks as the far end acknowledges data, so zero means it has everything
+size_t SctpTransport::unackedAmount() {
+	struct {
+		sctp_assoc_t ss_assoc_id;
+		uint32_t ss_total_sndbuf;
+		uint32_t ss_total_recv_buf;
+	} stat = {};
+	socklen_t len = sizeof(stat);
+	const int SctpGetSndbufUse = 0x00001101; // SCTP_GET_SNDBUF_USE, not in usrsctp.h
+	if (usrsctp_getsockopt(mSock, IPPROTO_SCTP, SctpGetSndbufUse, &stat, &len))
+		return 0;
+	return stat.ss_total_sndbuf;
+}
