# Zig code is not instrumented in native TSan runs, so socket handoffs through its futexes look like races
race:Io.Threaded.
# Known upstream usrsctp races between its socket, timer and input paths
race:sctp_sorecvmsg
race:sctp_express_handle_sack
race:sctp_handle_sack
race:sctp_clean_up_ctl
race:sctp_timer_start
race:sctp_timer_stop
race:sctp_handle_tick
race:sctp_send_sack
race:sctp_lower_sosend
race:sctp_process_data
race:sctp_med_chunk_output
race:sctp_chunk_output
race:sctp_calc_rwnd
race:sctp_pcb_add_flags
race:sctp_toss_old_cookies
race:sctp_timeout_handler
race:sctp_add_chk_to_control
race:sctp_handle_stream_reset
race:sctp_handle_stream_reset_response
# Mbed TLS caches the CPU feature probe without synchronization
race:mbedtls_aesni_has_support
race:sctp_setopt
race:sctp_send_shutdown_ack
race:sctp_send_stream_reset_out_if_possible
# libdatachannel resets channel callbacks from a remote close and from deletion without a shared lock
race:rtc::impl::Channel::resetCallbacks
race:rtc::impl::Channel::triggerClosed
race:sctp_send_shutdown
