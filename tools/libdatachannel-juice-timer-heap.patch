+static void conn_epoll_schedule(registry_impl_t *registry_impl, juice_agent_t *agent) {
+	conn_impl_t *conn_impl = agent->conn_impl;
+	timestamp_t time = conn_impl->next_timestamp;
+	if (agent->conn_index < 0 || (conn_impl->timer_set && conn_impl->timer_time <= time))
+		return;
+
+	if (registry_impl->timers_count == registry_impl->timers_size) {
+		int size = registry_impl->timers_size ? registry_impl->timers_size * 2 : 64;
+		conn_timer_t *timers = realloc(registry_impl->timers, size * sizeof(conn_timer_t));
+		if (!timers) {
+			// Retried by a full sweep, which reschedules every agent
+			JLOG_ERROR("Memory allocation failed for connection timers");
+			registry_impl->rescan = true;
+			return;
+		}
+		registry_impl->timers = timers;
+		registry_impl->timers_size = size;
+	}
+
+	conn_timer_t *timers = registry_impl->timers;
+	int i = registry_impl->timers_count++;
+	while (i > 0 && timers[(i - 1) / 2].time > time) {
+		timers[i] = timers[(i - 1) / 2];
+		i = (i - 1) / 2;
+	}
+	timers[i].time = time;
+	timers[i].index = agent->conn_index;
+	conn_impl->timer_set = true;
+	conn_impl->timer_time = time;
+}
+
+static conn_timer_t conn_epoll_pop_timer(registry_impl_t *registry_impl) {
+	conn_timer_t *timers = registry_impl->timers;
+	conn_timer_t top = timers[0];
+	conn_timer_t last = timers[--registry_impl->timers_count];
+	int count = registry_impl->timers_count;
+	int i = 0;
+	while (2 * i + 1 < count) {
+		int child = 2 * i + 1;
+		if (child + 1 < count && timers[child + 1].time < timers[child].time)
+			++child;
+		if (timers[child].time >= last.time)
+			break;
+		timers[i] = timers[child];
+		i = child;
+	}
+	if (count > 0)
+		timers[i] = last;
+	return top;
+}
+
+static void conn_epoll_fail(registry_impl_t *registry_impl, conn_impl_t *conn_impl) {
+	JLOG_WARN("Agent update failed");
+	conn_impl->state = CONN_STATE_FINISHED;
+	conn_epoll_unwatch(registry_impl, conn_impl);
+	registry_impl->live--;
+}
+
+static void conn_epoll_run_timers(conn_registry_t *registry, timestamp_t now) {
+	registry_impl_t *registry_impl = registry->impl;
+	while (registry_impl->timers_count > 0 && registry_impl->timers[0].time <= now) {
+		conn_timer_t timer = conn_epoll_pop_timer(registry_impl);
+		if (timer.index >= registry->agents_size)
+			continue;
+
+		juice_agent_t *agent = registry->agents[timer.index];
+		conn_impl_t *conn_impl = agent ? agent->conn_impl : NULL;
+		if (!conn_impl || conn_impl->state != CONN_STATE_READY || !conn_impl->timer_set ||
+		    conn_impl->timer_time != timer.time)
+			continue;
+
+		conn_impl->timer_set = false;
+		if (conn_impl->next_timestamp <= now &&
+		    agent_conn_update(agent, &conn_impl->next_timestamp) != 0) {
+			conn_epoll_fail(registry_impl, conn_impl);
+			continue;
+		}
+		conn_epoll_schedule(registry_impl, agent);
+	}
+}
