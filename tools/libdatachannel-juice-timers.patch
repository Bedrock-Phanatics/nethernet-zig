+// Only agents that received datagrams are updated until the earliest deadline passes
 int conn_mux_process(conn_registry_t *registry, struct pollfd *pfd) {
 	mutex_lock(&registry->mutex);
+	registry_impl_t *registry_impl = registry->impl;
+	timestamp_t now = current_timestamp();
+	juice_agent_t *received[1000];
+	int received_count = 0;
 
 	if (pfd->revents & POLLNVAL || pfd->revents & POLLERR) {
 		JLOG_ERROR("Error when polling socket");
@@ -458,7 +459,11 @@ int conn_mux_process(conn_registry_t *registry, struct pollfd *pfd) {
 				continue;
 			}
 
-			conn_impl->next_timestamp = current_timestamp();
+			conn_impl->next_timestamp = now;
+			if (!conn_impl->received) {
+				conn_impl->received = true;
+				received[received_count++] = agent;
+			}
 		}
 
 		if (ret < 0) {
@@ -468,17 +473,28 @@ int conn_mux_process(conn_registry_t *registry, struct pollfd *pfd) {
 		}
 	}
 
-	for (int i = 0; i < registry->agents_size; ++i) {
-		juice_agent_t *agent = registry->agents[i];
+	for (int i = 0; i < received_count; ++i)
+		((conn_impl_t *)received[i]->conn_impl)->received = false;
+
+	now = current_timestamp();
+	bool full = now >= registry_impl->next_timestamp;
+	int count = full ? registry->agents_size : received_count;
+	if (full)
+		registry_impl->next_timestamp = now + 60000;
+
+	for (int i = 0; i < count; ++i) {
+		juice_agent_t *agent = full ? registry->agents[i] : received[i];
 		if (is_ready(agent)) {
 			conn_impl_t *conn_impl = agent->conn_impl;
-			if (conn_impl->next_timestamp <= current_timestamp()) {
+			if (conn_impl->next_timestamp <= now) {
 				if (agent_conn_update(agent, &conn_impl->next_timestamp) != 0) {
 					JLOG_WARN("Agent update failed");
 					conn_impl->finished = true;
 					continue;
 				}
 			}
+			if (registry_impl->next_timestamp > conn_impl->next_timestamp)
+				registry_impl->next_timestamp = conn_impl->next_timestamp;
 		}
 	}
 
@@ -558,6 +574,7 @@ int conn_mux_init(juice_agent_t *agent, conn_registry_t *registry, udp_socket_co
 
 	conn_impl->registry = registry;
 	agent->conn_impl = conn_impl;
+	((registry_impl_t *)registry->impl)->next_timestamp = 0;
 	return 0;
 }
 
