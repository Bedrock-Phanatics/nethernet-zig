+// A stale event for a reused slot still names the old socket
+static uint64_t conn_epoll_key(socket_t sock, int index) {
+	return ((uint64_t)(uint32_t)sock << 32) | (uint32_t)index;
+}
+
+static void conn_epoll_watch(registry_impl_t *registry_impl, juice_agent_t *agent) {
+	conn_impl_t *conn_impl = agent->conn_impl;
+	if (conn_impl->epoll_udp || agent->conn_index < 0)
+		return;
+
+	struct epoll_event event;
+	memset(&event, 0, sizeof(event));
+	event.events = EPOLLIN;
+	event.data.u64 = conn_epoll_key(conn_impl->udp_sock, agent->conn_index);
+	if (epoll_ctl(registry_impl->epoll_fd, EPOLL_CTL_ADD, conn_impl->udp_sock, &event) == 0)
+		conn_impl->epoll_udp = true;
+	else
+		JLOG_WARN("epoll registration failed, errno=%d", errno);
+}
+
+static void conn_epoll_unwatch(registry_impl_t *registry_impl, conn_impl_t *conn_impl) {
+	if (!conn_impl->epoll_udp)
+		return;
+
+	epoll_ctl(registry_impl->epoll_fd, EPOLL_CTL_DEL, conn_impl->udp_sock, NULL);
+	conn_impl->epoll_udp = false;
+}
+
+static int conn_epoll_sweep(conn_registry_t *registry, timestamp_t now) {
+	registry_impl_t *registry_impl = registry->impl;
+	registry_impl->next_timestamp = now + 60000;
+	registry_impl->rescan = false;
+
+	int live = 0;
+	for (int i = 0; i < registry->agents_size; ++i) {
+		juice_agent_t *agent = registry->agents[i];
+		if (!agent)
+			continue;
+
+		conn_impl_t *conn_impl = agent->conn_impl;
+		if (!conn_impl ||
+		    (conn_impl->state != CONN_STATE_NEW && conn_impl->state != CONN_STATE_READY))
+			continue;
+
+		if (conn_impl->state == CONN_STATE_NEW)
+			conn_impl->state = CONN_STATE_READY;
+
+		conn_epoll_watch(registry_impl, agent);
+
+		if (conn_impl->next_timestamp <= now) {
+			if (agent_conn_update(agent, &conn_impl->next_timestamp) != 0) {
+				JLOG_WARN("Agent update failed");
+				conn_impl->state = CONN_STATE_FINISHED;
+				conn_epoll_unwatch(registry_impl, conn_impl);
+				continue;
+			}
+		}
+
+		if (registry_impl->next_timestamp > conn_impl->next_timestamp)
+			registry_impl->next_timestamp = conn_impl->next_timestamp;
+
+		live++;
+	}
+	return live;
+}
+
+static int conn_epoll_iteration(conn_registry_t *registry) {
+	registry_impl_t *registry_impl = registry->impl;
+	struct epoll_event events[64];
+
+	mutex_lock(&registry->mutex);
+	if (registry_impl->tcp_count > 0) {
+		mutex_unlock(&registry->mutex);
+		return 2;
+	}
+
+	timestamp_t now = current_timestamp();
+	if (registry_impl->rescan || now >= registry_impl->next_timestamp)
+		registry_impl->live = conn_epoll_sweep(registry, now);
+
+	int live = registry_impl->live;
+	timediff_t timediff = registry_impl->next_timestamp - now;
+	mutex_unlock(&registry->mutex);
+
+	if (live <= 0)
+		return 0;
+
+	if (timediff < 0)
+		timediff = 0;
+
+	JLOG_VERBOSE("Entering epoll for %d ms", (int)timediff);
+	int count = epoll_wait(registry_impl->epoll_fd, events, 64, (int)timediff);
+	JLOG_VERBOSE("Leaving epoll");
+	if (count < 0) {
+		if (errno == EINTR)
+			return 1;
+
+		JLOG_FATAL("epoll failed, errno=%d", errno);
+		return -1;
+	}
+
+	mutex_lock(&registry->mutex);
+	now = current_timestamp();
+	for (int k = 0; k < count; ++k) {
+		if (events[k].data.u64 == EPOLL_INTERRUPT_DATA) {
+			char dummy;
+			while (read(registry_impl->interrupt_pipe_in, &dummy, 1) > 0) {
+			}
+			continue;
+		}
+
+		uint32_t index = (uint32_t)events[k].data.u64;
+		socket_t sock = (socket_t)(events[k].data.u64 >> 32);
+		if (index >= (uint32_t)registry->agents_size)
+			continue;
+
+		juice_agent_t *agent = registry->agents[index];
+		if (!agent)
+			continue;
+
+		conn_impl_t *conn_impl = agent->conn_impl;
+		if (!conn_impl || conn_impl->state != CONN_STATE_READY || conn_impl->udp_sock != sock)
+			continue;
+
+		struct pollfd pfd;
+		pfd.fd = sock;
+		pfd.events = POLLIN;
+		pfd.revents = 0;
+		if (events[k].events & EPOLLIN)
+			pfd.revents |= POLLIN;
+		if (events[k].events & EPOLLERR)
+			pfd.revents |= POLLERR;
+		if (events[k].events & EPOLLHUP)
+			pfd.revents |= POLLHUP;
+
+		conn_poll_process_udp(agent, &pfd, now);
+
+		if (conn_impl->state == CONN_STATE_FINISHED) {
+			conn_epoll_unwatch(registry_impl, conn_impl);
+			registry_impl->live--;
+		} else if (registry_impl->next_timestamp > conn_impl->next_timestamp) {
+			registry_impl->next_timestamp = conn_impl->next_timestamp;
+		}
+	}
+	mutex_unlock(&registry->mutex);
+	return 1;
+}
