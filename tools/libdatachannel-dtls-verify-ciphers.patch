+// mbedTLS lists ChaCha20-Poly1305 first, but its ChaCha20 is portable C while AES-GCM uses AES-NI
+const int *DtlsTransport::PreferredCiphersuites() {
+	static const std::vector<int> ciphersuites = [] {
+		std::vector<int> list;
+		for (const int *id = mbedtls_ssl_list_ciphersuites(); *id; ++id)
+			list.push_back(*id);
+		auto rank = [](int id) {
+			const char *name = mbedtls_ssl_get_ciphersuite_name(id);
+			if (std::strstr(name, "-WITH-AES-128-GCM-"))
+				return 0;
+			return std::strstr(name, "-WITH-AES-256-GCM-") ? 1 : 2;
+		};
+		std::stable_sort(list.begin(), list.end(),
+		                 [&](int a, int b) { return rank(a) < rank(b); });
+		list.push_back(0);
+		return list;
+	}();
+	return ciphersuites.data();
